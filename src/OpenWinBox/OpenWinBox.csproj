<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>OpenWinBox</RootNamespace>
    <AssemblyName>OpenWinBox</AssemblyName>
    <!-- App de bandeja con poco trabajo: sin hilo de GC en segundo plano (menos hilos y memoria) -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <!-- SemVer: betas 1.0.0-beta.N hasta la versión final 1.0.0 (ver CHANGELOG.md) -->
    <Version>1.0.0-beta.2</Version>
    <!-- Generado con tools/make_icon.py -->
    <ApplicationIcon>Assets\OpenWinBox.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <Nullable>enable</Nullable>
    <!-- App sin empaquetar (exe normal) con el runtime de WinUI incluido -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- Usa las tareas de PRI del paquete NuGet; sin esto `dotnet build` busca las de Visual Studio -->
    <EnableMsixTooling>true</EnableMsixTooling>
  </PropertyGroup>

  <ItemGroup>
    <!-- La bandeja y las ventanas cargan el .ico desde la carpeta de la app -->
    <Content Include="Assets\OpenWinBox.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.250205002" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.1742" />
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
  </ItemGroup>

</Project>
