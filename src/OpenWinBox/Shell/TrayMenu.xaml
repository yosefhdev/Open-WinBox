<Window
    x:Class="OpenWinBox.TrayMenu"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:OpenWinBox">

    <Window.SystemBackdrop>
        <local:WidgetBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="Root" KeyDown="Root_KeyDown">
        <Grid.Resources>
            <!-- Fila del menú: sin fondo ni borde hasta pasar el mouse, como los menús de Windows 11 -->
            <Style x:Key="MenuRow" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Padding" Value="10,0" />
                <Setter Property="Height" Value="38" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            </Style>
            <Style x:Key="MenuIcon" TargetType="FontIcon">
                <Setter Property="FontSize" Value="16" />
                <Setter Property="Margin" Value="0,0,12,0" />
            </Style>
            <!-- El ToggleSwitch mide ~154 px aunque no tenga texto y empuja la fila. Va dentro de un Canvas del tamaño
                 del riel (40×20): el Canvas no hereda ese ancho ni recorta, así queda pegado a la derecha como la tecla F7 -->
            <Style x:Key="MenuSwitch" TargetType="ToggleSwitch">
                <Setter Property="OnContent" Value="" />
                <Setter Property="OffContent" Value="" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Canvas.Top" Value="-10" />
                <Setter Property="IsHitTestVisible" Value="False" />
                <Setter Property="IsTabStop" Value="False" />
            </Style>
        </Grid.Resources>

        <!-- Región de título vacía: sin ella WinUI vuelve arrastrable la franja de arriba y tapa los clics -->
        <Border x:Name="NoTitleBar" Width="0" Height="0" />

        <StackPanel x:Name="Panel" Padding="6" Spacing="2">
            <!-- Encabezado -->
            <Grid Padding="10,8,10,10" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Image x:Name="AppIcon" Width="28" Height="28" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="OpenWinBox" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock x:Name="Status" Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Grid>
            <Rectangle Height="1" Margin="4,0,4,4" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

            <Button Style="{StaticResource MenuRow}" Click="Toggle_Click" AutomationProperties.Name="Mostrar u ocultar widgets">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE890;" Style="{StaticResource MenuIcon}" />
                    <TextBlock Grid.Column="1" Text="Mostrar / ocultar widgets" VerticalAlignment="Center" />
                    <!-- Tecla del atajo -->
                    <Border Grid.Column="2" Padding="6,1" CornerRadius="4" VerticalAlignment="Center"
                            BorderThickness="1" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                            Background="{ThemeResource ControlFillColorSecondaryBrush}">
                        <TextBlock Text="F7" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Border>
                </Grid>
            </Button>

            <Button Style="{StaticResource MenuRow}" Click="Pin_Click" AutomationProperties.Name="Mantener en el escritorio">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE718;" Style="{StaticResource MenuIcon}" />
                    <TextBlock Grid.Column="1" Text="Mantener en el escritorio" VerticalAlignment="Center" />
                    <Canvas Grid.Column="2" Width="40" Height="20"><ToggleSwitch x:Name="PinSwitch" Style="{StaticResource MenuSwitch}" /></Canvas>
                </Grid>
            </Button>

            <Button Style="{StaticResource MenuRow}" Click="AutoStart_Click" AutomationProperties.Name="Iniciar con Windows">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE768;" Style="{StaticResource MenuIcon}" />
                    <TextBlock Grid.Column="1" Text="Iniciar con Windows" VerticalAlignment="Center" />
                    <Canvas Grid.Column="2" Width="40" Height="20"><ToggleSwitch x:Name="AutoStartSwitch" Style="{StaticResource MenuSwitch}" /></Canvas>
                </Grid>
            </Button>

            <Rectangle Height="1" Margin="4" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

            <Button Style="{StaticResource MenuRow}" Click="Settings_Click" AutomationProperties.Name="Configuración">
                <StackPanel Orientation="Horizontal">
                    <FontIcon Glyph="&#xE713;" Style="{StaticResource MenuIcon}" />
                    <TextBlock Text="Configuración" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <Button Style="{StaticResource MenuRow}" Click="Exit_Click" AutomationProperties.Name="Salir">
                <!-- Salir se marca en rojo al pasar el mouse: es la única acción que cierra la app -->
                <Button.Resources>
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#33E81123" />
                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#4DE81123" />
                </Button.Resources>
                <StackPanel Orientation="Horizontal">
                    <FontIcon Glyph="&#xE7E8;" Style="{StaticResource MenuIcon}" />
                    <TextBlock Text="Salir" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</Window>
