<Application
    x:Class="OpenWinBox.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Acento coral como el DeskBox original (botones principales, interruptores, selección) -->
            <Color x:Key="SystemAccentColor">#E86F55</Color>
            <Color x:Key="SystemAccentColorLight1">#EC836B</Color>
            <Color x:Key="SystemAccentColorLight2">#F09782</Color>
            <Color x:Key="SystemAccentColorLight3">#F5B4A4</Color>
            <Color x:Key="SystemAccentColorDark1">#D05A41</Color>
            <Color x:Key="SystemAccentColorDark2">#B5472F</Color>
            <Color x:Key="SystemAccentColorDark3">#933520</Color>

            <!-- Tarjeta de ajuste: fila con ícono, título, descripción y control a la derecha -->
            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="16,12" />
                <Setter Property="MinHeight" Value="68" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
