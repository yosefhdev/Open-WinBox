<UserControl
    x:Class="OpenWinBox.WeatherView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <SolidColorBrush x:Key="ButtonBackground" Color="Transparent" />
        <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent" />
        <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
        <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
    </UserControl.Resources>

    <!-- Como el widget Tiempo del original: ubicación, ícono + temperatura + estado, y humedad/viento/precipitación -->
    <Grid Padding="14,8,8,12" RowDefinitions="Auto,*,Auto">
        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="4">
            <FontIcon Glyph="&#xE81D;" FontSize="12" VerticalAlignment="Center"
                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock x:Name="PlaceText" Grid.Column="1" Text="Ubicación actual" FontSize="12" VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
            <Button x:Name="RefreshButton" Grid.Column="2" Padding="6" Click="Refresh_Click"
                    AutomationProperties.Name="Actualizar" ToolTipService.ToolTip="Actualizar">
                <FontIcon Glyph="&#xE72C;" FontSize="12" />
            </Button>
            <Button Grid.Column="3" Padding="6" Click="Settings_Click"
                    AutomationProperties.Name="Elegir ubicación" ToolTipService.ToolTip="Elegir ubicación">
                <FontIcon Glyph="&#xE713;" FontSize="12" />
            </Button>
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
            <TextBlock x:Name="IconText" FontFamily="Segoe UI Emoji" FontSize="34" VerticalAlignment="Center" />
            <TextBlock x:Name="TempText" FontSize="34" FontWeight="SemiBold" VerticalAlignment="Center" Text="--°C" />
            <StackPanel VerticalAlignment="Center" Spacing="1">
                <TextBlock x:Name="ConditionText" FontSize="13" FontWeight="SemiBold" Text="Cargando…" />
                <TextBlock x:Name="FeelsText" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </StackPanel>

        <!-- Columnas con nombre: al ocultar un dato su columna pasa a ancho 0 y las demás se reparten el espacio -->
        <Grid x:Name="Stats" Grid.Row="2" Padding="0,8,6,0" BorderThickness="0,1,0,0"
              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="HumidityColumn" />
                <ColumnDefinition x:Name="WindColumn" />
                <ColumnDefinition x:Name="RainColumn" />
            </Grid.ColumnDefinitions>
            <StackPanel HorizontalAlignment="Center" Spacing="1">
                <TextBlock Text="Humedad" FontSize="11" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock x:Name="HumidityText" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" Text="--" />
            </StackPanel>
            <StackPanel Grid.Column="1" HorizontalAlignment="Center" Spacing="1">
                <TextBlock Text="Viento" FontSize="11" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock x:Name="WindText" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" Text="--" />
            </StackPanel>
            <StackPanel Grid.Column="2" HorizontalAlignment="Center" Spacing="1">
                <TextBlock Text="Precipitación" FontSize="11" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock x:Name="RainText" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" Text="--" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
