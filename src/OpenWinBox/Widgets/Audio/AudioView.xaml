<UserControl
    x:Class="OpenWinBox.AudioView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <SolidColorBrush x:Key="ButtonBackground" Color="Transparent" />
        <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent" />
        <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
        <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
    </UserControl.Resources>

    <!-- Como el panel Audio de la Game Bar (Win+G): salida, entrada y volumen por aplicación -->
    <!-- Arriba 22: la agarradera para mover el widget (alto 22) no tapa el selector de salida -->
    <Grid Padding="12,22,12,10" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="6">
        <Grid x:Name="OutputPanel" ColumnDefinitions="Auto,*,36" ColumnSpacing="4" RowDefinitions="Auto,Auto">
            <Button x:Name="OutputDevice" Grid.ColumnSpan="3" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                    Padding="6,3" Click="Device_Click" Tag="Output" AutomationProperties.Name="Dispositivo de salida"
                    ToolTipService.ToolTip="Cambiar dispositivo de salida">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                    <TextBlock Text="Salida" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="OutputName" Grid.Column="1" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <FontIcon Grid.Column="2" Glyph="&#xE70D;" FontSize="10" />
                </Grid>
            </Button>
            <Button x:Name="OutputMute" Grid.Row="1" Padding="6" Click="Mute_Click" Tag="Output"
                    AutomationProperties.Name="Silenciar salida" ToolTipService.ToolTip="Silenciar">
                <FontIcon x:Name="OutputMuteIcon" Glyph="&#xE767;" FontSize="14" />
            </Button>
            <Slider x:Name="OutputSlider" Grid.Row="1" Grid.Column="1" Maximum="100" VerticalAlignment="Center"
                    ValueChanged="DeviceSlider_ValueChanged" Tag="Output" AutomationProperties.Name="Volumen de salida" />
            <TextBlock x:Name="OutputValue" Grid.Row="1" Grid.Column="2" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right" />
        </Grid>

        <Grid x:Name="InputPanel" Grid.Row="1" ColumnDefinitions="Auto,*,36" ColumnSpacing="4" RowDefinitions="Auto,Auto">
            <Button x:Name="InputDevice" Grid.ColumnSpan="3" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                    Padding="6,3" Click="Device_Click" Tag="Input" AutomationProperties.Name="Dispositivo de entrada"
                    ToolTipService.ToolTip="Cambiar dispositivo de entrada">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                    <TextBlock Text="Entrada" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="InputName" Grid.Column="1" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <FontIcon Grid.Column="2" Glyph="&#xE70D;" FontSize="10" />
                </Grid>
            </Button>
            <Button x:Name="InputMute" Grid.Row="1" Padding="6" Click="Mute_Click" Tag="Input"
                    AutomationProperties.Name="Silenciar micrófono" ToolTipService.ToolTip="Silenciar">
                <FontIcon x:Name="InputMuteIcon" Glyph="&#xE720;" FontSize="14" />
            </Button>
            <Slider x:Name="InputSlider" Grid.Row="1" Grid.Column="1" Maximum="100" VerticalAlignment="Center"
                    ValueChanged="DeviceSlider_ValueChanged" Tag="Input" AutomationProperties.Name="Volumen de entrada" />
            <TextBlock x:Name="InputValue" Grid.Row="1" Grid.Column="2" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right" />
        </Grid>

        <TextBlock Grid.Row="2" Text="Aplicaciones" FontSize="12" Margin="6,4,0,0"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="AppList" Spacing="2" />
        </ScrollViewer>
        <TextBlock x:Name="NoApps" Grid.Row="3" Text="Ninguna app está reproduciendo sonido" FontSize="12" Margin="6,4,0,0"
                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" Visibility="Collapsed" />
    </Grid>
</UserControl>
