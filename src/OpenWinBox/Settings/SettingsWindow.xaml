<Window
    x:Class="OpenWinBox.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:OpenWinBox"
    Title="OpenWinBox — Configuración">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="Root" RowDefinitions="48,*">
        <StackPanel x:Name="TitleBar" Orientation="Horizontal" Spacing="10" Padding="16,0" VerticalAlignment="Center">
            <Image x:Name="TitleIcon" Width="16" Height="16" />
            <TextBlock Text="OpenWinBox" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
        </StackPanel>

        <NavigationView x:Name="Nav" Grid.Row="1" PaneDisplayMode="Left" OpenPaneLength="230"
                        IsBackButtonVisible="Collapsed" IsSettingsVisible="False"
                        SelectionChanged="Nav_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="General" Tag="General">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE80F;" Foreground="#F7A541" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Apariencia" Tag="Apariencia">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE734;" Foreground="#F5C518" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Widgets de archivos" Tag="Widgets">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE8B7;" Foreground="#4A9FEA" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Widgets funcionales" Tag="Funcionales">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE74C;" Foreground="#4CC38A" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Atajos e interacción" Tag="Atajos">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE724;" Foreground="#3B82F6" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Acerca de" Tag="Acerca">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE946;" Foreground="#4A9FEA" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <ScrollViewer>
                <StackPanel MaxWidth="860" Padding="28,4,28,28" Spacing="4" HorizontalAlignment="Stretch">
                    <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,8,0,16">
                        <!-- Solo en las páginas de un widget: vuelve a "Widgets funcionales" -->
                        <Button x:Name="SubPageBack" Style="{StaticResource NavigationBackButtonNormalStyle}" Visibility="Collapsed"
                                Click="SubPageBack_Click" AutomationProperties.Name="Volver a Widgets funcionales"
                                ToolTipService.ToolTip="Volver a Widgets funcionales" />
                        <TextBlock x:Name="PageTitle" Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- General -->
                    <StackPanel x:Name="GeneralPage" Spacing="4">
                        <local:SettingRow Glyph="&#xE7E8;" Header="Lanzar al inicio"
                                          Description="Inicia OpenWinBox en segundo plano después de iniciar sesión en Windows">
                            <local:SettingRow.Action>
                                <ToggleSwitch x:Name="AutoStartToggle" OnContent="" OffContent="" MinWidth="0"
                                              Toggled="AutoStartToggle_Toggled" AutomationProperties.Name="Lanzar al inicio" />
                            </local:SettingRow.Action>
                        </local:SettingRow>
                        <local:SettingRow Glyph="&#xE8A5;" Header="Primeros pasos"
                                          Description="Repasa cómo crear widgets, mostrarlos con F7 y mantenerlos en el escritorio">
                            <local:SettingRow.Action>
                                <Button Click="Onboarding_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE8A5;" FontSize="14" />
                                        <TextBlock Text="Ver" />
                                    </StackPanel>
                                </Button>
                            </local:SettingRow.Action>
                        </local:SettingRow>
                    </StackPanel>

                    <!-- Apariencia -->
                    <StackPanel x:Name="AparienciaPage" Spacing="4" Visibility="Collapsed">
                        <local:SettingRow Glyph="&#xE790;" Header="Tema" Description="Se aplica a todas las ventanas y widgets">
                            <local:SettingRow.Action>
                                <ComboBox x:Name="ThemeCombo" MinWidth="200" SelectionChanged="ThemeCombo_SelectionChanged"
                                          AutomationProperties.Name="Tema">
                                    <ComboBoxItem Content="Usar el del sistema" Tag="Default" />
                                    <ComboBoxItem Content="Claro" Tag="Light" />
                                    <ComboBoxItem Content="Oscuro" Tag="Dark" />
                                </ComboBox>
                            </local:SettingRow.Action>
                        </local:SettingRow>
                    </StackPanel>

                    <!-- Widgets de archivos -->
                    <StackPanel x:Name="WidgetsPage" Spacing="4" Visibility="Collapsed">
                        <local:SettingRow Glyph="&#xE710;" Header="Nuevo widget"
                                          Description="Elige una carpeta; su contenido aparece en un widget nuevo en el escritorio">
                            <local:SettingRow.Action>
                                <Button Style="{StaticResource AccentButtonStyle}" Click="NewWidget_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE710;" FontSize="14" />
                                        <TextBlock Text="Nuevo widget" />
                                    </StackPanel>
                                </Button>
                            </local:SettingRow.Action>
                        </local:SettingRow>
                        <local:SettingRow Glyph="&#xE71B;" Header="Tiempo para agrupar"
                                          Description="Cuánto mantener un widget sobre la barra de otro para unirlos como pestañas">
                            <local:SettingRow.Action>
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Slider x:Name="MergeDelaySlider" Width="180" Minimum="0.2" Maximum="3" StepFrequency="0.1"
                                            ValueChanged="MergeDelaySlider_ValueChanged" AutomationProperties.Name="Tiempo para agrupar, en segundos" />
                                    <TextBlock x:Name="MergeDelayText" VerticalAlignment="Center" MinWidth="40" />
                                </StackPanel>
                            </local:SettingRow.Action>
                        </local:SettingRow>
                        <TextBlock Text="Tus widgets" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,16,0,4" />
                        <StackPanel x:Name="WidgetList" Spacing="4" />
                    </StackPanel>

                    <!-- Widgets funcionales: clic en una fila (o en ›) abre su configuración en esta misma ventana -->
                    <StackPanel x:Name="FuncionalesPage" Spacing="4" Visibility="Collapsed">
                        <local:SettingRow Glyph="&#xE8D6;" Header="Música" Tag="Music" Tapped="FeatureRow_Tapped"
                                          Description="Control de medios del sistema, progreso y carátula de lo que se está reproduciendo">
                            <local:SettingRow.Action>
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <ToggleSwitch x:Name="MusicToggle" OnContent="" OffContent="" MinWidth="0" Tag="Music"
                                                  Toggled="FeatureToggle_Toggled" AutomationProperties.Name="Música" />
                                    <Button Tag="Music" Click="OpenFeature_Click" Background="Transparent" BorderThickness="0"
                                            AutomationProperties.Name="Configurar Música" ToolTipService.ToolTip="Configurar Música">
                                        <FontIcon Glyph="&#xE76C;" FontSize="12" />
                                    </Button>
                                </StackPanel>
                            </local:SettingRow.Action>
                        </local:SettingRow>
                        <local:SettingRow Glyph="&#xE787;" Header="Glance" Tag="Glance" Tapped="FeatureRow_Tapped"
                                          Description="La hora y la fecha de un vistazo, sobre la foto del día de Bing">
                            <local:SettingRow.Action>
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <ToggleSwitch x:Name="GlanceToggle" OnContent="" OffContent="" MinWidth="0" Tag="Glance"
                                                  Toggled="FeatureToggle_Toggled" AutomationProperties.Name="Glance" />
                                    <Button Tag="Glance" Click="OpenFeature_Click" Background="Transparent" BorderThickness="0"
                                            AutomationProperties.Name="Configurar Glance" ToolTipService.ToolTip="Configurar Glance">
                                        <FontIcon Glyph="&#xE76C;" FontSize="12" />
                                    </Button>
                                </StackPanel>
                            </local:SettingRow.Action>
                        </local:SettingRow>
                        <local:SettingRow Glyph="&#xE706;" Header="Tiempo" Tag="Weather" Tapped="FeatureRow_Tapped"
                                          Description="Clima actual de tu ubicación: temperatura, humedad, viento y precipitación">
                            <local:SettingRow.Action>
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <ToggleSwitch x:Name="WeatherToggle" OnContent="" OffContent="" MinWidth="0" Tag="Weather"
                                                  Toggled="FeatureToggle_Toggled" AutomationProperties.Name="Tiempo" />
                                    <Button Tag="Weather" Click="OpenFeature_Click" Background="Transparent" BorderThickness="0"
                                            AutomationProperties.Name="Configurar Tiempo" ToolTipService.ToolTip="Configurar Tiempo">
                                        <FontIcon Glyph="&#xE76C;" FontSize="12" />
                                    </Button>
                                </StackPanel>
                            </local:SettingRow.Action>
                        </local:SettingRow>
                        <local:SettingRow Glyph="&#xE7F6;" Header="Spotify" Tag="Spotify" Tapped="FeatureRow_Tapped"
                                          Description="Solo lo que suena en Spotify, con sus colores, aleatorio y repetir, aunque se reproduzca otra cosa">
                            <local:SettingRow.Action>
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <ToggleSwitch x:Name="SpotifyToggle" OnContent="" OffContent="" MinWidth="0" Tag="Spotify"
                                                  Toggled="FeatureToggle_Toggled" AutomationProperties.Name="Spotify" />
                                    <Button Tag="Spotify" Click="OpenFeature_Click" Background="Transparent" BorderThickness="0"
                                            AutomationProperties.Name="Configurar Spotify" ToolTipService.ToolTip="Configurar Spotify">
                                        <FontIcon Glyph="&#xE76C;" FontSize="12" />
                                    </Button>
                                </StackPanel>
                            </local:SettingRow.Action>
                        </local:SettingRow>
                        <local:SettingRow Glyph="&#xE767;" Header="Audio"
                                          Description="Elige la salida y el micrófono, y ajusta el volumen de cada app, como en Win+G">
                            <local:SettingRow.Action>
                                <ToggleSwitch x:Name="AudioToggle" OnContent="" OffContent="" MinWidth="0" Tag="Audio"
                                              Toggled="FeatureToggle_Toggled" AutomationProperties.Name="Audio" />
                            </local:SettingRow.Action>
                        </local:SettingRow>
                    </StackPanel>

                    <!-- Widgets funcionales › Música -->
                    <StackPanel x:Name="MusicOptionsPage" Spacing="4" Visibility="Collapsed">
                        <TextBlock Text="Estilo" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,0,0,4" />
                        <!-- Vista previa en vivo de cada estilo con lo que está sonando; clic para elegirlo -->
                        <ContentPresenter x:Name="MusicStylePreviews" />
                        <TextBlock Text="Elementos visibles" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,16,0,4" />
                        <local:SettingRow Glyph="&#xE8B9;" Header="Carátula" Description="Imagen del álbum o del video">
                            <local:SettingRow.Action>
                                <ToggleSwitch OnContent="" OffContent="" MinWidth="0" Tag="Music.ShowArtwork" Toggled="OptionToggle_Toggled"
                                              AutomationProperties.Name="Carátula" />
                            </local:SettingRow.Action>
                        </local:SettingRow>
                        <local:SettingRow Glyph="&#xE77B;" Header="Artista" Description="Debajo del título">
                            <local:SettingRow.Action>
                                <ToggleSwitch OnContent="" OffContent="" MinWidth="0" Tag="Music.ShowArtist" Toggled="OptionToggle_Toggled"
                                              AutomationProperties.Name="Artista" />
                            </local:SettingRow.Action>
                        </local:SettingRow>
                        <local:SettingRow Glyph="&#xE946;" Header="Estado" Description="Reproduciendo o en pausa (no aparece en el estilo Compacto)">
                            <local:SettingRow.Action>
                                <ToggleSwitch OnContent="" OffContent="" MinWidth="0" Tag="Music.ShowStatus" Toggled="OptionToggle_Toggled"
                                              AutomationProperties.Name="Estado" />
                            </local:SettingRow.Action>
                        </local:SettingRow>
                        <local:SettingRow Glyph="&#xE916;" Header="Barra de progreso" Description="Tiempo transcurrido y duración (no aparece en el estilo Compacto)">
                            <local:SettingRow.Action>
                                <ToggleSwitch OnContent="" OffContent="" MinWidth="0" Tag="Music.ShowProgress" Toggled="OptionToggle_Toggled"
                                              AutomationProperties.Name="Barra de progreso" />
                            </local:SettingRow.Action>
                        </local:SettingRow>
                        <local:SettingRow Glyph="&#xE768;" Header="Controles" Description="Anterior, reproducir o pausar y siguiente">
                            <local:SettingRow.Action>
                                <ToggleSwitch OnContent="" OffContent="" MinWidth="0" Tag="Music.ShowControls" Toggled="OptionToggle_Toggled"
                                              AutomationProperties.Name="Controles" />
                            </local:SettingRow.Action>
                        </local:SettingRow>
                    </StackPanel>

                    <!-- Widgets funcionales › Spotify -->
                    <StackPanel x:Name="SpotifyOptionsPage" Spacing="4" Visibility="Collapsed">
                        <TextBlock Text="Estilo" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,0,0,4" />
                        <!-- Vista previa en vivo de cada estilo con lo que está sonando; clic para elegirlo -->
                        <ContentPresenter x:Name="SpotifyStylePreviews" />
                        <TextBlock Text="Elementos visibles" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,16,0,4" />
                        <local:SettingRow Glyph="&#xE8B9;" Header="Carátula" Description="Imagen del álbum o del video">
                            <local:SettingRow.Action>
                                <ToggleSwitch OnContent="" OffContent="" MinWidth="0" Tag="Spotify.ShowArtwork" Toggled="OptionToggle_Toggled"
                                              AutomationProperties.Name="Carátula" />
                            </local:SettingRow.Action>
                        </local:SettingRow>
                        <local:SettingRow Glyph="&#xE77B;" Header="Artista" Description="Debajo del título">
                            <local:SettingRow.Action>
                                <ToggleSwitch OnContent="" OffContent="" MinWidth="0" Tag="Spotify.ShowArtist" Toggled="OptionToggle_Toggled"
                                              AutomationProperties.Name="Artista" />
                            </local:SettingRow.Action>
                        </local:SettingRow>
                        <local:SettingRow Glyph="&#xE946;" Header="Estado" Description="Reproduciendo o en pausa (no aparece en el estilo Compacto)">
                            <local:SettingRow.Action>
                                <ToggleSwitch OnContent="" OffContent="" MinWidth="0" Tag="Spotify.ShowStatus" Toggled="OptionToggle_Toggled"
                                              AutomationProperties.Name="Estado" />
                            </local:SettingRow.Action>
                        </local:SettingRow>
                        <local:SettingRow Glyph="&#xE916;" Header="Barra de progreso" Description="Tiempo transcurrido y duración (no aparece en el estilo Compacto)">
                            <local:SettingRow.Action>
                                <ToggleSwitch OnContent="" OffContent="" MinWidth="0" Tag="Spotify.ShowProgress" Toggled="OptionToggle_Toggled"
                                              AutomationProperties.Name="Barra de progreso" />
                            </local:SettingRow.Action>
                        </local:SettingRow>
                        <local:SettingRow Glyph="&#xE768;" Header="Controles" Description="Aleatorio, anterior, reproducir o pausar, siguiente y repetir">
                            <local:SettingRow.Action>
                                <ToggleSwitch OnContent="" OffContent="" MinWidth="0" Tag="Spotify.ShowControls" Toggled="OptionToggle_Toggled"
                                              AutomationProperties.Name="Controles" />
                            </local:SettingRow.Action>
                        </local:SettingRow>
                    </StackPanel>

                    <!-- Widgets funcionales › Glance -->
                    <StackPanel x:Name="GlanceOptionsPage" Spacing="4" Visibility="Collapsed">
                        <TextBlock Text="Elementos visibles" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,16,0,4" />
                        <local:SettingRow Glyph="&#xE787;" Header="Fecha" Description="Día y mes debajo de la hora">
                            <local:SettingRow.Action>
                                <ToggleSwitch OnContent="" OffContent="" MinWidth="0" Tag="Glance.ShowDate" Toggled="OptionToggle_Toggled"
                                              AutomationProperties.Name="Fecha" />
                            </local:SettingRow.Action>
                        </local:SettingRow>
                        <local:SettingRow Glyph="&#xE787;" Header="Año" Description="Junto a la fecha">
                            <local:SettingRow.Action>
                                <ToggleSwitch OnContent="" OffContent="" MinWidth="0" Tag="Glance.ShowYear" Toggled="OptionToggle_Toggled"
                                              AutomationProperties.Name="Año" />
                            </local:SettingRow.Action>
                        </local:SettingRow>
                        <local:SettingRow Glyph="&#xE8BF;" Header="Día de la semana" Description="Lunes, martes…">
                            <local:SettingRow.Action>
                                <ToggleSwitch OnContent="" OffContent="" MinWidth="0" Tag="Glance.ShowWeekday" Toggled="OptionToggle_Toggled"
                                              AutomationProperties.Name="Día de la semana" />
                            </local:SettingRow.Action>
                        </local:SettingRow>
                        <local:SettingRow Glyph="&#xE823;" Header="Formato de 24 horas" Description="Apagado: 12 horas con a.m. y p.m.">
                            <local:SettingRow.Action>
                                <ToggleSwitch OnContent="" OffContent="" MinWidth="0" Tag="Glance.Use24Hour" Toggled="OptionToggle_Toggled"
                                              AutomationProperties.Name="Formato de 24 horas" />
                            </local:SettingRow.Action>
                        </local:SettingRow>
                        <TextBlock Text="Segundo reloj" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,16,0,4" />
                        <local:SettingRow Glyph="&#xE774;" Header="Mostrar un segundo reloj" Description="La hora de otra zona horaria, al lado del principal y del mismo tamaño">
                            <local:SettingRow.Action>
                                <ToggleSwitch OnContent="" OffContent="" MinWidth="0" Tag="Glance.ShowSecondClock" Toggled="OptionToggle_Toggled"
                                              AutomationProperties.Name="Mostrar un segundo reloj" />
                            </local:SettingRow.Action>
                        </local:SettingRow>
                        <local:SettingRow Glyph="&#xE8AC;" Header="Nombre del reloj principal" Description="Vacío: la ciudad de la zona horaria de Windows">
                            <local:SettingRow.Action>
                                <TextBox x:Name="LocalLabelBox" Width="200" TextChanged="LocalLabelBox_TextChanged"
                                         AutomationProperties.Name="Nombre del reloj principal" />
                            </local:SettingRow.Action>
                        </local:SettingRow>
                        <local:SettingRow Glyph="&#xE909;" Header="Zona horaria" Description="La del segundo reloj">
                            <local:SettingRow.Action>
                                <ComboBox x:Name="TimeZoneCombo" Width="320" SelectionChanged="TimeZoneCombo_SelectionChanged"
                                          AutomationProperties.Name="Zona horaria del segundo reloj" />
                            </local:SettingRow.Action>
                        </local:SettingRow>
                        <local:SettingRow Glyph="&#xE8AC;" Header="Nombre del segundo reloj" Description="Vacío: el nombre de la zona (p. ej. Madrid)">
                            <local:SettingRow.Action>
                                <TextBox x:Name="SecondLabelBox" Width="200" PlaceholderText="Nombre del reloj"
                                         TextChanged="SecondLabelBox_TextChanged" AutomationProperties.Name="Nombre del segundo reloj" />
                            </local:SettingRow.Action>
                        </local:SettingRow>
                    </StackPanel>

                    <!-- Widgets funcionales › Tiempo -->
                    <StackPanel x:Name="WeatherOptionsPage" Spacing="4" Visibility="Collapsed">
                        <local:SettingRow x:Name="WeatherLocationRow" Glyph="&#xE81D;" Header="Ubicación del clima">
                            <local:SettingRow.Action>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <AutoSuggestBox x:Name="CitySearch" Width="260" PlaceholderText="Buscar ciudad…" QueryIcon="Find"
                                                    TextChanged="CitySearch_TextChanged" SuggestionChosen="CitySearch_SuggestionChosen"
                                                    QuerySubmitted="CitySearch_QuerySubmitted" AutomationProperties.Name="Buscar ciudad" />
                                    <Button x:Name="AutoLocationButton" Content="Usar automática" Click="AutoLocation_Click" />
                                </StackPanel>
                            </local:SettingRow.Action>
                        </local:SettingRow>
                        <TextBlock Text="Elementos visibles" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,16,0,4" />
                        <local:SettingRow Glyph="&#xE9CA;" Header="Sensación térmica" Description="Se siente…, debajo del estado del cielo">
                            <local:SettingRow.Action>
                                <ToggleSwitch OnContent="" OffContent="" MinWidth="0" Tag="Weather.ShowFeelsLike" Toggled="OptionToggle_Toggled"
                                              AutomationProperties.Name="Sensación térmica" />
                            </local:SettingRow.Action>
                        </local:SettingRow>
                        <local:SettingRow Glyph="&#xE945;" Header="Humedad" Description="Porcentaje de humedad del aire">
                            <local:SettingRow.Action>
                                <ToggleSwitch OnContent="" OffContent="" MinWidth="0" Tag="Weather.ShowHumidity" Toggled="OptionToggle_Toggled"
                                              AutomationProperties.Name="Humedad" />
                            </local:SettingRow.Action>
                        </local:SettingRow>
                        <local:SettingRow Glyph="&#xE9F1;" Header="Viento" Description="Velocidad del viento en km/h">
                            <local:SettingRow.Action>
                                <ToggleSwitch OnContent="" OffContent="" MinWidth="0" Tag="Weather.ShowWind" Toggled="OptionToggle_Toggled"
                                              AutomationProperties.Name="Viento" />
                            </local:SettingRow.Action>
                        </local:SettingRow>
                        <local:SettingRow Glyph="&#xE9E0;" Header="Precipitación" Description="Probabilidad de lluvia para hoy">
                            <local:SettingRow.Action>
                                <ToggleSwitch OnContent="" OffContent="" MinWidth="0" Tag="Weather.ShowRain" Toggled="OptionToggle_Toggled"
                                              AutomationProperties.Name="Precipitación" />
                            </local:SettingRow.Action>
                        </local:SettingRow>
                    </StackPanel>

                    <!-- Atajos e interacción -->
                    <StackPanel x:Name="AtajosPage" Spacing="4" Visibility="Collapsed">
                        <local:SettingRow Glyph="&#xE81E;" Header="Capa de widgets"
                                          Description="Fijo en el escritorio: siempre detrás de tus apps. Normal: se comportan como ventanas comunes">
                            <local:SettingRow.Action>
                                <ComboBox x:Name="LayerCombo" MinWidth="200" SelectionChanged="LayerCombo_SelectionChanged"
                                          AutomationProperties.Name="Capa de widgets">
                                    <ComboBoxItem Content="Fijo en el escritorio" />
                                    <ComboBoxItem Content="Normal" />
                                </ComboBox>
                            </local:SettingRow.Action>
                        </local:SettingRow>
                        <local:SettingRow Glyph="&#xE765;" Header="Tecla de acceso rápido global"
                                          Description="F7 muestra u oculta todos los widgets, igual que el clic izquierdo en el ícono de la bandeja">
                            <local:SettingRow.Action>
                                <Border Padding="10,4" CornerRadius="4" BorderThickness="1"
                                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                        Background="{ThemeResource ControlFillColorDefaultBrush}">
                                    <TextBlock Text="F7" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                </Border>
                            </local:SettingRow.Action>
                        </local:SettingRow>
                        <InfoBar x:Name="HotkeyWarning" Severity="Warning" IsClosable="False"
                                 Title="F7 está ocupado por otra aplicación"
                                 Message="Cierra la otra app (por ejemplo, el DeskBox original) y reinicia OpenWinBox. Mientras tanto usa el ícono de la bandeja." />
                        <InfoBar IsOpen="True" Severity="Informational" IsClosable="False"
                                 Title="¿Por qué los atajos de teclado a veces no responden?"
                                 Message="Si la ventana activa se ejecuta como administrador (por ejemplo, el Administrador de tareas), Windows bloquea los atajos globales. Es una limitación de Windows." />
                    </StackPanel>

                    <!-- Acerca de -->
                    <StackPanel x:Name="AcercaPage" Spacing="4" Visibility="Collapsed">
                        <Border Style="{StaticResource CardStyle}">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                                <Image x:Name="AboutIcon" Width="40" Height="40" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock x:Name="VersionText" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="Widgets de código abierto para el escritorio de Windows." Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <Button Grid.Column="2" Click="OpenDataFolder_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE838;" FontSize="14" />
                                        <TextBlock Text="Carpeta de configuración" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>
                        <local:SettingRow x:Name="UpdateRow" Glyph="&#xE895;" Header="Actualizaciones"
                                          Description="Comprueba si hay una versión nueva de OpenWinBox">
                            <local:SettingRow.Action>
                                <Button x:Name="CheckUpdatesButton" Content="Buscar actualizaciones" Click="CheckUpdates_Click" />
                            </local:SettingRow.Action>
                        </local:SettingRow>
                        <local:SettingRow Glyph="&#xE7C1;" Header="Canal de actualizaciones"
                                          Description="Oficiales: solo versiones estables. Betas: también versiones de prueba, con novedades antes y posibles fallos">
                            <local:SettingRow.Action>
                                <ComboBox x:Name="UpdateChannelCombo" MinWidth="200" SelectionChanged="UpdateChannelCombo_SelectionChanged"
                                          AutomationProperties.Name="Canal de actualizaciones">
                                    <ComboBoxItem Content="Oficiales" />
                                    <ComboBoxItem Content="Betas" />
                                </ComboBox>
                            </local:SettingRow.Action>
                        </local:SettingRow>
                        <InfoBar x:Name="UpdateBar" IsClosable="False">
                            <InfoBar.ActionButton>
                                <Button x:Name="UpdateActionButton" Click="UpdateAction_Click" />
                            </InfoBar.ActionButton>
                            <StackPanel Spacing="4" Margin="0,0,0,8">
                                <HyperlinkButton x:Name="UpdateNotesLink" Content="Ver los cambios" Padding="0" />
                                <ProgressBar x:Name="UpdateProgress" Maximum="1" Margin="0,4,0,0"
                                             AutomationProperties.Name="Progreso de la descarga" />
                            </StackPanel>
                        </InfoBar>
                        <!-- CC BY 4.0 de Open-Meteo exige atribución -->
                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" Margin="4,8,4,0"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                            <Run Text="Software libre bajo licencia MIT. Datos del clima:" />
