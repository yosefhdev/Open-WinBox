<Window
    x:Class="OpenWinBox.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:OpenWinBox">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="Root" RowDefinitions="48,*">
        <StackPanel x:Name="TitleBar" Orientation="Horizontal" Spacing="10" Padding="16,0" VerticalAlignment="Center">
            <Image x:Name="TitleIcon" Width="16" Height="16" />
            <TextBlock Text="OpenWinBox" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
        </StackPanel>

        <NavigationView x:Name="Nav" Grid.Row="1" PaneDisplayMode="Left" OpenPaneLength="230"
                        IsBackButtonVisible="Collapsed" IsSettingsVisible="False"
                        SelectionChanged="Nav_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="{local:T Key=settings.nav.general}" Tag="General">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE80F;" Foreground="#F7A541" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="{local:T Key=settings.nav.appearance}" Tag="Apariencia">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE734;" Foreground="#F5C518" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="{local:T Key=settings.nav.fileWidgets}" Tag="Widgets">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE8B7;" Foreground="#4A9FEA" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="{local:T Key=settings.nav.featureWidgets}" Tag="Funcionales">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE74C;" Foreground="#4CC38A" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="{local:T Key=settings.nav.shortcuts}" Tag="Atajos">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE724;" Foreground="#3B82F6" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="{local:T Key=settings.nav.about}" Tag="Acerca">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE946;" Foreground="#4A9FEA" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <ScrollViewer>
                <StackPanel MaxWidth="860" Padding="28,4,28,28" Spacing="4" HorizontalAlignment="Stretch">
                    <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,8,0,16">
                        <!-- Solo en las páginas de un widget: vuelve a "Widgets funcionales" -->
                        <Button x:Name="SubPageBack" Style="{StaticResource NavigationBackButtonNormalStyle}" Visibility="Collapsed"
                                Click="SubPageBack_Click" AutomationProperties.Name="{local:T Key=settings.backToFeatures}"
                                ToolTipService.ToolTip="{local:T Key=settings.backToFeatures}" />
                        <TextBlock x:Name="PageTitle" Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- General -->
                    <StackPanel x:Name="GeneralPage" Spacing="4">
                        <local:SettingRow Glyph="&#xE7E8;" Header="{local:T Key=settings.autoStart}"
                                          Description="{local:T Key=settings.autoStart.desc}">
                            <local:SettingRow.Action>
                                <ToggleSwitch x:Name="AutoStartToggle" OnContent="" OffContent="" MinWidth="0"
                                              Toggled="AutoStartToggle_Toggled" AutomationProperties.Name="{local:T Key=settings.autoStart}" />
                            </local:SettingRow.Action>
                        </local:SettingRow>
                        <local:SettingRow Glyph="&#xE774;" Header="{local:T Key=settings.language}"
                                          Description="{local:T Key=settings.language.desc}">
                            <local:SettingRow.Action>
                                <ComboBox x:Name="LanguageCombo" MinWidth="200" SelectionChanged="LanguageCombo_SelectionChanged"
                                          AutomationProperties.Name="{local:T Key=settings.language}" />
                            </local:SettingRow.Action>
                        </local:SettingRow>
                        <local:SettingRow Glyph="&#xE8A5;" Header="{local:T Key=settings.onboarding}"
                                          Description="{local:T Key=settings.onboarding.desc}">
                            <local:SettingRow.Action>
                                <Button Click="Onboarding_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE8A5;" FontSize="14" />
                                        <TextBlock Text="{local:T Key=settings.onboarding.view}" />
                                    </StackPanel>
                                </Button>
                            </local:SettingRow.Action>
                        </local:SettingRow>
                    </StackPanel>

                    <!-- Apariencia -->
                    <StackPanel x:Name="AparienciaPage" Spacing="4" Visibility="Collapsed">
                        <local:SettingRow Glyph="&#xE790;" Header="{local:T Key=settings.theme}" Description="{local:T Key=settings.theme.desc}">
                            <local:SettingRow.Action>
                                <ComboBox x:Name="ThemeCombo" MinWidth="200" SelectionChanged="ThemeCombo_SelectionChanged"
                                          AutomationProperties.Name="{local:T Key=settings.theme}">
                                    <ComboBoxItem Content="{local:T Key=settings.theme.system}" Tag="Default" />
                                    <ComboBoxItem Content="{local:T Key=settings.theme.light}" Tag="Light" />
                                    <ComboBoxItem Content="{local:T Key=settings.theme.dark}" Tag="Dark" />
                                </ComboBox>
                            </local:SettingRow.Action>
                        </local:SettingRow>
                    </StackPanel>

                    <!-- Widgets de archivos -->
                    <StackPanel x:Name="WidgetsPage" Spacing="4" Visibility="Collapsed">
                        <local:SettingRow Glyph="&#xE710;" Header="{local:T Key=common.newWidget}"
                                          Description="{local:T Key=settings.newWidget.desc}">
                            <local:SettingRow.Action>
                                <Button Style="{StaticResource AccentButtonStyle}" Click="NewWidget_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE710;" FontSize="14" />
                                        <TextBlock Text="{local:T Key=common.newWidget}" />
                                    </StackPanel>
                                </Button>
                            </local:SettingRow.Action>
                        </local:SettingRow>
                        <local:SettingRow Glyph="&#xE71B;" Header="{local:T Key=settings.mergeDelay}"
                                          Description="{local:T Key=settings.mergeDelay.desc}">
                            <local:SettingRow.Action>
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Slider x:Name="MergeDelaySlider" Width="180" Minimum="0.2" Maximum="3" StepFrequency="0.1"
                                            ValueChanged="MergeDelaySlider_ValueChanged" AutomationProperties.Name="{local:T Key=settings.mergeDelay.name}" />
                                    <TextBlock x:Name="MergeDelayText" VerticalAlignment="Center" MinWidth="40" />
                                </StackPanel>
                            </local:SettingRow.Action>
                        </local:SettingRow>
                        <TextBlock Text="{local:T Key=settings.yourWidgets}" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,16,0,4" />
                        <StackPanel x:Name="WidgetList" Spacing="4" />
                    </StackPanel>

                    <!-- Widgets funcionales: clic en una fila (o en ›) abre su configuración en esta misma ventana -->
                    <StackPanel x:Name="FuncionalesPage" Spacing="4" Visibility="Collapsed">
                        <local:SettingRow Glyph="&#xE8D6;" Header="{local:T Key=feature.music}" Tag="Music" Tapped="FeatureRow_Tapped"
                                          Description="{local:T Key=settings.music.desc}">
                            <local:SettingRow.Action>
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <ToggleSwitch x:Name="MusicToggle" OnContent="" OffContent="" MinWidth="0" Tag="Music"
                                                  Toggled="FeatureToggle_Toggled" AutomationProperties.Name="{local:T Key=feature.music}" />
                                    <Button Tag="Music" Click="OpenFeature_Click" Background="Transparent" BorderThickness="0"
                                            AutomationProperties.Name="{local:T Key=settings.music.configure}" ToolTipService.ToolTip="{local:T Key=settings.music.configure}">
                                        <FontIcon Glyph="&#xE76C;" FontSize="12" />
                                    </Button>
                                </StackPanel>
                            </local:SettingRow.Action>
                        </local:SettingRow>
                        <local:SettingRow Glyph="&#xE787;" Header="Glance" Tag="Glance" Tapped="FeatureRow_Tapped"
                                          Description="{local:T Key=settings.glance.desc}">
                            <local:SettingRow.Action>
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <ToggleSwitch x:Name="GlanceToggle" OnContent="" OffContent="" MinWidth="0" Tag="Glance"
                                                  Toggled="FeatureToggle_Toggled" AutomationProperties.Name="Glance" />
                                    <Button Tag="Glance" Click="OpenFeature_Click" Background="Transparent" BorderThickness="0"
                                            AutomationProperties.Name="{local:T Key=settings.glance.configure}" ToolTipService.ToolTip="{local:T Key=settings.glance.configure}">
                                        <FontIcon Glyph="&#xE76C;" FontSize="12" />
                                    </Button>
                                </StackPanel>
                            </local:SettingRow.Action>
                        </local:SettingRow>
                        <local:SettingRow Glyph="&#xE706;" Header="{local:T Key=feature.weather}" Tag="Weather" Tapped="FeatureRow_Tapped"
                                          Description="{local:T Key=settings.weather.desc}">
                            <local:SettingRow.Action>
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <ToggleSwitch x:Name="WeatherToggle" OnContent="" OffContent="" MinWidth="0" Tag="Weather"
                                                  Toggled="FeatureToggle_Toggled" AutomationProperties.Name="{local:T Key=feature.weather}" />
                                    <Button Tag="Weather" Click="OpenFeature_Click" Background="Transparent" BorderThickness="0"
                                            AutomationProperties.Name="{local:T Key=settings.weather.configure}" ToolTipService.ToolTip="{local:T Key=settings.weather.configure}">
                                        <FontIcon Glyph="&#xE76C;" FontSize="12" />
                                    </Button>
                                </StackPanel>
                            </local:SettingRow.Action>
                        </local:SettingRow>
                        <local:SettingRow Glyph="&#xE7F6;" Header="Spotify" Tag="Spotify" Tapped="FeatureRow_Tapped"
                                          Description="{local:T Key=settings.spotify.desc}">
                            <local:SettingRow.Action>
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <ToggleSwitch x:Name="SpotifyToggle" OnContent="" OffContent="" MinWidth="0" Tag="Spotify"
                                                  Toggled="FeatureToggle_Toggled" AutomationProperties.Name="Spotify" />
                                    <Button Tag="Spotify" Click="OpenFeature_Click" Background="Transparent" BorderThickness="0"
                                            AutomationProperties.Name="{local:T Key=settings.spotify.configure}" ToolTipService.ToolTip="{local:T Key=settings.spotify.configure}">
                                        <FontIcon Glyph="&#xE76C;" FontSize="12" />
                                    </Button>
                                </StackPanel>
                            </local:SettingRow.Action>
                        </local:SettingRow>
                        <local:SettingRow Glyph="&#xE767;" Header="Audio"
                                          Description="{local:T Key=settings.audio.desc}">
                            <local:SettingRow.Action>
                                <ToggleSwitch x:Name="AudioToggle" OnContent="" OffContent="" MinWidth="0" Tag="Audio"
                                              Toggled="FeatureToggle_Toggled" AutomationProperties.Name="Audio" />
                            </local:SettingRow.Action>
                        </local:SettingRow>
                    </StackPanel>

                    <!-- Widgets funcionales › Música -->
                    <StackPanel x:Name="MusicOptionsPage" Spacing="4" Visibility="Collapsed">
                        <TextBlock Text="{local:T Key=common.style}" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,0,0,4" />
                        <!-- Vista previa en vivo de cada estilo con lo que está sonando; clic para elegirlo -->
                        <ContentPresenter x:Name="MusicStylePreviews" />
                        <TextBlock Text="{local:T Key=common.visibleItems}" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,16,0,4" />
                        <local:SettingRow Glyph="&#xE8B9;" Header="{local:T Key=common.artwork}" Description="{local:T Key=settings.artwork.desc}">
                            <local:SettingRow.Action>
                                <ToggleSwitch OnContent="" OffContent="" MinWidth="0" Tag="Music.ShowArtwork" Toggled="OptionToggle_Toggled"
                                              AutomationProperties.Name="{local:T Key=common.artwork}" />
                            </local:SettingRow.Action>
                        </local:SettingRow>
                        <local:SettingRow Glyph="&#xE77B;" Header="{local:T Key=common.artist}" Description="{local:T Key=settings.artist.desc}">
                            <local:SettingRow.Action>
                                <ToggleSwitch OnContent="" OffContent="" MinWidth="0" Tag="Music.ShowArtist" Toggled="OptionToggle_Toggled"
                                              AutomationProperties.Name="{local:T Key=common.artist}" />
                            </local:SettingRow.Action>
                        </local:SettingRow>
                        <local:SettingRow Glyph="&#xE946;" Header="{local:T Key=common.status}" Description="{local:T Key=settings.status.desc}">
                            <local:SettingRow.Action>
                                <ToggleSwitch OnContent="" OffContent="" MinWidth="0" Tag="Music.ShowStatus" Toggled="OptionToggle_Toggled"
                                              AutomationProperties.Name="{local:T Key=common.status}" />
                            </local:SettingRow.Action>
                        </local:SettingRow>
                        <local:SettingRow Glyph="&#xE916;" Header="{local:T Key=common.progressBar}" Description="{local:T Key=settings.progress.desc}">
                            <local:SettingRow.Action>
                                <ToggleSwitch OnContent="" OffContent="" MinWidth="0" Tag="Music.ShowProgress" Toggled="OptionToggle_Toggled"
                                              AutomationProperties.Name="{local:T Key=common.progressBar}" />
                            </local:SettingRow.Action>
                        </local:SettingRow>
                        <local:SettingRow Glyph="&#xE768;" Header="{local:T Key=common.controls}" Description="{local:T Key=settings.controls.music.desc}">
                            <local:SettingRow.Action>
                                <ToggleSwitch OnContent="" OffContent="" MinWidth="0" Tag="Music.ShowControls" Toggled="OptionToggle_Toggled"
                                              AutomationProperties.Name="{local:T Key=common.controls}" />
                            </local:SettingRow.Action>
                        </local:SettingRow>
                    </StackPanel>

                    <!-- Widgets funcionales › Spotify -->
                    <StackPanel x:Name="SpotifyOptionsPage" Spacing="4" Visibility="Collapsed">
                        <TextBlock Text="{local:T Key=common.style}" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,0,0,4" />
                        <!-- Vista previa en vivo de cada estilo con lo que está sonando; clic para elegirlo -->
                        <ContentPresenter x:Name="SpotifyStylePreviews" />
                        <TextBlock Text="{local:T Key=common.visibleItems}" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,16,0,4" />
                        <local:SettingRow Glyph="&#xE8B9;" Header="{local:T Key=common.artwork}" Description="{local:T Key=settings.artwork.desc}">
                            <local:SettingRow.Action>
                                <ToggleSwitch OnContent="" OffContent="" MinWidth="0" Tag="Spotify.ShowArtwork" Toggled="OptionToggle_Toggled"
                                              AutomationProperties.Name="{local:T Key=common.artwork}" />
                            </local:SettingRow.Action>
                        </local:SettingRow>
                        <local:SettingRow Glyph="&#xE77B;" Header="{local:T Key=common.artist}" Description="{local:T Key=settings.artist.desc}">
                            <local:SettingRow.Action>
                                <ToggleSwitch OnContent="" OffContent="" MinWidth="0" Tag="Spotify.ShowArtist" Toggled="OptionToggle_Toggled"
                                              AutomationProperties.Name="{local:T Key=common.artist}" />
                            </local:SettingRow.Action>
                        </local:SettingRow>
                        <local:SettingRow Glyph="&#xE946;" Header="{local:T Key=common.status}" Description="{local:T Key=settings.status.desc}">
                            <local:SettingRow.Action>
                                <ToggleSwitch OnContent="" OffContent="" MinWidth="0" Tag="Spotify.ShowStatus" Toggled="OptionToggle_Toggled"
                                              AutomationProperties.Name="{local:T Key=common.status}" />
                            </local:SettingRow.Action>
                        </local:SettingRow>
                        <local:SettingRow Glyph="&#xE916;" Header="{local:T Key=common.progressBar}" Description="{local:T Key=settings.progress.desc}">
                            <local:SettingRow.Action>
                                <ToggleSwitch OnContent="" OffContent="" MinWidth="0" Tag="Spotify.ShowProgress" Toggled="OptionToggle_Toggled"
                                              AutomationProperties.Name="{local:T Key=common.progressBar}" />
                            </local:SettingRow.Action>
                        </local:SettingRow>
                        <local:SettingRow Glyph="&#xE768;" Header="{local:T Key=common.controls}" Description="{local:T Key=settings.controls.spotify.desc}">
                            <local:SettingRow.Action>
                                <ToggleSwitch OnContent="" OffContent="" MinWidth="0" Tag="Spotify.ShowControls" Toggled="OptionToggle_Toggled"
                                              AutomationProperties.Name="{local:T Key=common.controls}" />
                            </local:SettingRow.Action>
                        </local:SettingRow>
                    </StackPanel>

                    <!-- Widgets funcionales › Glance -->
                    <StackPanel x:Name="GlanceOptionsPage" Spacing="4" Visibility="Collapsed">
                        <TextBlock Text="{local:T Key=common.visibleItems}" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,16,0,4" />
                        <local:SettingRow Glyph="&#xE787;" Header="{local:T Key=settings.date}" Description="{local:T Key=settings.date.desc}">
                            <local:SettingRow.Action>
                                <ToggleSwitch OnContent="" OffContent="" MinWidth="0" Tag="Glance.ShowDate" Toggled="OptionToggle_Toggled"
                                              AutomationProperties.Name="{local:T Key=settings.date}" />
                            </local:SettingRow.Action>
                        </local:SettingRow>
                        <local:SettingRow Glyph="&#xE787;" Header="{local:T Key=settings.year}" Description="{local:T Key=settings.year.desc}">
                            <local:SettingRow.Action>
                                <ToggleSwitch OnContent="" OffContent="" MinWidth="0" Tag="Glance.ShowYear" Toggled="OptionToggle_Toggled"
                                              AutomationProperties.Name="{local:T Key=settings.year}" />
                            </local:SettingRow.Action>
                        </local:SettingRow>
                        <local:SettingRow Glyph="&#xE8BF;" Header="{local:T Key=settings.weekday}" Description="{local:T Key=settings.weekday.desc}">
                            <local:SettingRow.Action>
                                <ToggleSwitch OnContent="" OffContent="" MinWidth="0" Tag="Glance.ShowWeekday" Toggled="OptionToggle_Toggled"
                                              AutomationProperties.Name="{local:T Key=settings.weekday}" />
                            </local:SettingRow.Action>
                        </local:SettingRow>
                        <local:SettingRow Glyph="&#xE823;" Header="{local:T Key=settings.hour24}" Description="{local:T Key=settings.hour24.desc}">
                            <local:SettingRow.Action>
                                <ToggleSwitch OnContent="" OffContent="" MinWidth="0" Tag="Glance.Use24Hour" Toggled="OptionToggle_Toggled"
                                              AutomationProperties.Name="{local:T Key=settings.hour24}" />
                            </local:SettingRow.Action>
                        </local:SettingRow>
                        <TextBlock Text="{local:T Key=settings.secondClock}" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,16,0,4" />
                        <local:SettingRow Glyph="&#xE774;" Header="{local:T Key=settings.secondClock.show}" Description="{local:T Key=settings.secondClock.desc}">
                            <local:SettingRow.Action>
                                <ToggleSwitch OnContent="" OffContent="" MinWidth="0" Tag="Glance.ShowSecondClock" Toggled="OptionToggle_Toggled"
                                              AutomationProperties.Name="{local:T Key=settings.secondClock.show}" />
                            </local:SettingRow.Action>
                        </local:SettingRow>
                        <local:SettingRow Glyph="&#xE8AC;" Header="{local:T Key=settings.localLabel}" Description="{local:T Key=settings.localLabel.desc}">
                            <local:SettingRow.Action>
                                <TextBox x:Name="LocalLabelBox" Width="200" TextChanged="LocalLabelBox_TextChanged"
                                         AutomationProperties.Name="{local:T Key=settings.localLabel}" />
                            </local:SettingRow.Action>
                        </local:SettingRow>
                        <local:SettingRow Glyph="&#xE909;" Header="{local:T Key=common.timeZone}" Description="{local:T Key=settings.timeZone.desc}">
                            <local:SettingRow.Action>
                                <ComboBox x:Name="TimeZoneCombo" Width="320" SelectionChanged="TimeZoneCombo_SelectionChanged"
                                          AutomationProperties.Name="{local:T Key=settings.timeZone.name}" />
                            </local:SettingRow.Action>
                        </local:SettingRow>
                        <local:SettingRow Glyph="&#xE8AC;" Header="{local:T Key=settings.secondLabel}" Description="{local:T Key=settings.secondLabel.desc}">
                            <local:SettingRow.Action>
                                <TextBox x:Name="SecondLabelBox" Width="200" PlaceholderText="{local:T Key=settings.clockName}"
                                         TextChanged="SecondLabelBox_TextChanged" AutomationProperties.Name="{local:T Key=settings.secondLabel}" />
                            </local:SettingRow.Action>
                        </local:SettingRow>
                    </StackPanel>

                    <!-- Widgets funcionales › Tiempo -->
                    <StackPanel x:Name="WeatherOptionsPage" Spacing="4" Visibility="Collapsed">
                        <local:SettingRow x:Name="WeatherLocationRow" Glyph="&#xE81D;" Header="{local:T Key=settings.location}">
                            <local:SettingRow.Action>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <AutoSuggestBox x:Name="CitySearch" Width="260" PlaceholderText="{local:T Key=settings.citySearch}" QueryIcon="Find"
                                                    TextChanged="CitySearch_TextChanged" SuggestionChosen="CitySearch_SuggestionChosen"
                                                    QuerySubmitted="CitySearch_QuerySubmitted" AutomationProperties.Name="{local:T Key=settings.citySearch.name}" />
                                    <Button x:Name="AutoLocationButton" Content="{local:T Key=settings.useAutomatic}" Click="AutoLocation_Click" />
                                </StackPanel>
                            </local:SettingRow.Action>
                        </local:SettingRow>
                        <TextBlock Text="{local:T Key=common.visibleItems}" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,16,0,4" />
                        <local:SettingRow Glyph="&#xE9CA;" Header="{local:T Key=settings.feelsLike}" Description="{local:T Key=settings.feelsLike.desc}">
                            <local:SettingRow.Action>
                                <ToggleSwitch OnContent="" OffContent="" MinWidth="0" Tag="Weather.ShowFeelsLike" Toggled="OptionToggle_Toggled"
                                              AutomationProperties.Name="{local:T Key=settings.feelsLike}" />
                            </local:SettingRow.Action>
                        </local:SettingRow>
                        <local:SettingRow Glyph="&#xE945;" Header="{local:T Key=common.humidity}" Description="{local:T Key=settings.humidity.desc}">
                            <local:SettingRow.Action>
                                <ToggleSwitch OnContent="" OffContent="" MinWidth="0" Tag="Weather.ShowHumidity" Toggled="OptionToggle_Toggled"
                                              AutomationProperties.Name="{local:T Key=common.humidity}" />
                            </local:SettingRow.Action>
                        </local:SettingRow>
                        <local:SettingRow Glyph="&#xE9F1;" Header="{local:T Key=common.wind}" Description="{local:T Key=settings.wind.desc}">
                            <local:SettingRow.Action>
                                <ToggleSwitch OnContent="" OffContent="" MinWidth="0" Tag="Weather.ShowWind" Toggled="OptionToggle_Toggled"
                                              AutomationProperties.Name="{local:T Key=common.wind}" />
                            </local:SettingRow.Action>
                        </local:SettingRow>
                        <local:SettingRow Glyph="&#xE9E0;" Header="{local:T Key=common.precipitation}" Description="{local:T Key=settings.rain.desc}">
                            <local:SettingRow.Action>
                                <ToggleSwitch OnContent="" OffContent="" MinWidth="0" Tag="Weather.ShowRain" Toggled="OptionToggle_Toggled"
                                              AutomationProperties.Name="{local:T Key=common.precipitation}" />
                            </local:SettingRow.Action>
                        </local:SettingRow>
                    </StackPanel>

                    <!-- Atajos e interacción -->
                    <StackPanel x:Name="AtajosPage" Spacing="4" Visibility="Collapsed">
                        <local:SettingRow Glyph="&#xE81E;" Header="{local:T Key=settings.layer}"
                                          Description="{local:T Key=settings.layer.desc}">
                            <local:SettingRow.Action>
                                <ComboBox x:Name="LayerCombo" MinWidth="200" SelectionChanged="LayerCombo_SelectionChanged"
                                          AutomationProperties.Name="{local:T Key=settings.layer}">
                                    <ComboBoxItem Content="{local:T Key=settings.layer.pinned}" />
                                    <ComboBoxItem Content="{local:T Key=settings.layer.normal}" />
                                </ComboBox>
                            </local:SettingRow.Action>
                        </local:SettingRow>
                        <local:SettingRow Glyph="&#xE765;" Header="{local:T Key=settings.hotkey}"
                                          Description="{local:T Key=settings.hotkey.desc}">
                            <local:SettingRow.Action>
                                <Border Padding="10,4" CornerRadius="4" BorderThickness="1"
                                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                        Background="{ThemeResource ControlFillColorDefaultBrush}">
                                    <TextBlock Text="F7" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                </Border>
                            </local:SettingRow.Action>
                        </local:SettingRow>
                        <InfoBar x:Name="HotkeyWarning" Severity="Warning" IsClosable="False"
                                 Title="{local:T Key=settings.hotkeyBusy.title}"
                                 Message="{local:T Key=settings.hotkeyBusy.message}" />
                        <InfoBar IsOpen="True" Severity="Informational" IsClosable="False"
                                 Title="{local:T Key=settings.hotkeyAdmin.title}"
                                 Message="{local:T Key=settings.hotkeyAdmin.message}" />
                    </StackPanel>

                    <!-- Acerca de -->
                    <StackPanel x:Name="AcercaPage" Spacing="4" Visibility="Collapsed">
                        <Border Style="{StaticResource CardStyle}">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                                <Image x:Name="AboutIcon" Width="40" Height="40" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock x:Name="VersionText" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="{local:T Key=settings.about.tagline}" Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <Button Grid.Column="2" Click="OpenDataFolder_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE838;" FontSize="14" />
                                        <TextBlock Text="{local:T Key=settings.about.dataFolder}" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>
                        <local:SettingRow x:Name="UpdateRow" Glyph="&#xE895;" Header="{local:T Key=settings.updates}"
                                          Description="{local:T Key=settings.updates.desc}">
                            <local:SettingRow.Action>
                                <Button x:Name="CheckUpdatesButton" Content="{local:T Key=settings.updates.check}" Click="CheckUpdates_Click" />
                            </local:SettingRow.Action>
                        </local:SettingRow>
                        <local:SettingRow Glyph="&#xE7C1;" Header="{local:T Key=settings.updates.channel}"
                                          Description="{local:T Key=settings.updates.channel.desc}">
                            <local:SettingRow.Action>
                                <ComboBox x:Name="UpdateChannelCombo" MinWidth="200" SelectionChanged="UpdateChannelCombo_SelectionChanged"
                                          AutomationProperties.Name="{local:T Key=settings.updates.channel}">
                                    <ComboBoxItem Content="{local:T Key=settings.updates.official}" />
                                    <ComboBoxItem Content="{local:T Key=settings.updates.betas}" />
                                </ComboBox>
                            </local:SettingRow.Action>
                        </local:SettingRow>
                        <InfoBar x:Name="UpdateBar" IsClosable="False">
                            <InfoBar.ActionButton>
                                <Button x:Name="UpdateActionButton" Click="UpdateAction_Click" />
                            </InfoBar.ActionButton>
                            <StackPanel Spacing="4" Margin="0,0,0,8">
                                <HyperlinkButton x:Name="UpdateNotesLink" Content="{local:T Key=settings.updates.notes}" Padding="0" />
                                <ProgressBar x:Name="UpdateProgress" Maximum="1" Margin="0,4,0,0"
                                             AutomationProperties.Name="{local:T Key=settings.updates.progress}" />
                            </StackPanel>
                        </InfoBar>
                        <!-- CC BY 4.0 de Open-Meteo exige atribución -->
                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" Margin="4,8,4,0"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                            <Run Text="{local:T Key=settings.about.credits1}" />
                            <Hyperlink NavigateUri="https://open-meteo.com/">Open-Meteo.com</Hyperlink>
                            <Run Text="{local:T Key=settings.about.credits2}" />
                            <Hyperlink NavigateUri="https://www.bigdatacloud.com/">BigDataCloud</Hyperlink><Run Text="." />
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </NavigationView>
    </Grid>
</Window>
