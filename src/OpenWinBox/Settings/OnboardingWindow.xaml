<Window
    x:Class="OpenWinBox.OnboardingWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:OpenWinBox">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="Root" ColumnDefinitions="2*,3*">
        <!-- Ilustración del paso -->
        <Grid Background="{ThemeResource SubtleFillColorSecondaryBrush}">
            <Border Width="132" Height="132" CornerRadius="20" BorderThickness="1.5"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource AccentFillColorDefaultBrush}">
                <Grid>
                    <FontIcon x:Name="IllustrationIcon" FontSize="56" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                    <TextBlock x:Name="IllustrationKey" Text="F7" FontSize="40" FontWeight="SemiBold" Visibility="Collapsed"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Column="1" RowDefinitions="48,*,Auto">
            <Grid ColumnDefinitions="Auto,*">
                <Button x:Name="BackButton" Style="{StaticResource NavigationBackButtonNormalStyle}" Margin="4,0,0,0"
                        Click="Back_Click" AutomationProperties.Name="{local:T Key=onboarding.previous}" />
                <!-- Zona para arrastrar la ventana; los botones no pueden estar dentro de ella -->
                <Grid x:Name="DragArea" Grid.Column="1" Background="Transparent" />
            </Grid>

            <StackPanel Grid.Row="1" VerticalAlignment="Center" Spacing="14" Padding="40,0,32,0">
                <TextBlock x:Name="StepTitle" Style="{StaticResource TitleTextBlockStyle}" TextWrapping="Wrap" />
                <TextBlock x:Name="StepText" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <ContentPresenter x:Name="StepExtra" />
            </StackPanel>

            <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Padding="40,0,32,28">
                <PipsPager x:Name="Pips" NumberOfPages="4" VerticalAlignment="Center"
                           SelectedIndexChanged="Pips_SelectedIndexChanged" AutomationProperties.Name="{local:T Key=onboarding.steps}" />
                <Button x:Name="NextButton" Grid.Column="1" MinWidth="140" Style="{StaticResource AccentButtonStyle}"
                        Click="Next_Click" />
            </Grid>
        </Grid>
    </Grid>
</Window>
