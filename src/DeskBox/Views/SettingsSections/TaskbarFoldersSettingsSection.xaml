<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DeskBox.Views.SettingsSections.TaskbarFoldersSettingsSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:svc="using:DeskBox.Services"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Styles/SettingsOverviewResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <StackPanel Style="{StaticResource SectionPanelStyle}">
            <TextBlock Style="{StaticResource SectionTitleTextStyle}" AutomationProperties.HeadingLevel="Level1" svc:Localized.Key="Settings.Section.TaskbarFolders" />
            <InfoBar IsOpen="True" IsClosable="False" Severity="Warning" Margin="0,8,0,0" Title="Work in Progress">
                <TextBlock Margin="0,0,0,12" TextWrapping="Wrap" svc:Localized.Key="Taskbar.WorkInProgress.Message" />
            </InfoBar>
            <StackPanel Margin="0,8,0,0" Spacing="4">
                <toolkit:SettingsCard
                    svc:Localized.HeaderKey="TaskbarFolders.Intro.Title"
                    svc:Localized.DescriptionKey="TaskbarFolders.Intro">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE8B7;" />
                    </toolkit:SettingsCard.HeaderIcon>
                    <Button x:Name="NewFolderButton" Style="{StaticResource AccentButtonStyle}" Click="NewFolderButton_Click">
                        <TextBlock svc:Localized.Key="TaskbarFolders.New" />
                    </Button>
                </toolkit:SettingsCard>

                <InfoBar x:Name="ErrorInfoBar" IsOpen="False" Severity="Error" IsClosable="True" />

                <toolkit:SettingsCard
                    x:Name="EmptyCard"
                    svc:Localized.HeaderKey="TaskbarFolders.Empty.Title"
                    svc:Localized.DescriptionKey="TaskbarFolders.Empty.Description">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE7C3;" />
                    </toolkit:SettingsCard.HeaderIcon>
                </toolkit:SettingsCard>

                <StackPanel x:Name="FoldersHost" Spacing="4" />
            </StackPanel>
        </StackPanel>

        <!-- Off-screen icon render surface: RenderTargetBitmap only captures
             elements that are in the live tree, so the .ico is drawn here
             instead of from a preview that may sit in a collapsed expander. -->
        <Canvas x:Name="IconRenderCanvas" Width="0" Height="0" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw">
            <Border x:Name="IconRenderSurface" Canvas.Left="-4000" Canvas.Top="-4000" Width="128" Height="128" />
        </Canvas>
    </Grid>
</UserControl>
