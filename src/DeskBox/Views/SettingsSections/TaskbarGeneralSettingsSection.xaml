<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DeskBox.Views.SettingsSections.TaskbarGeneralSettingsSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:svc="using:DeskBox.Services"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Styles/SettingsOverviewResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- Own taskbar add-on: install / pause / uninstall and where it shows. -->
    <StackPanel Style="{StaticResource SectionPanelStyle}">
        <TextBlock Style="{StaticResource SectionTitleTextStyle}" AutomationProperties.HeadingLevel="Level1" svc:Localized.Key="Settings.Section.General" />
        <StackPanel Margin="0,8,0,0" Spacing="4">
            <toolkit:SettingsCard x:Name="TaskbarAddonCard" svc:Localized.HeaderKey="Taskbar.Addon.Title">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE90C;" />
                </toolkit:SettingsCard.HeaderIcon>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ProgressRing x:Name="TaskbarAddonBusy" Width="16" Height="16" IsActive="False" Visibility="Collapsed" />
                    <Button x:Name="TaskbarAddonUninstallButton" Click="TaskbarAddonUninstallButton_Click">
                        <TextBlock svc:Localized.Key="Taskbar.Addon.Uninstall" />
                    </Button>
                    <Button x:Name="TaskbarAddonPauseButton" Click="TaskbarAddonPauseButton_Click">
                        <TextBlock svc:Localized.Key="Taskbar.Addon.Pause" />
                    </Button>
                    <Button x:Name="TaskbarAddonStartButton" Style="{StaticResource AccentButtonStyle}" Click="TaskbarAddonStartButton_Click">
                        <TextBlock x:Name="TaskbarAddonStartText" />
                    </Button>
                </StackPanel>
            </toolkit:SettingsCard>

            <toolkit:SettingsCard
                x:Name="TaskbarAllMonitorsCard"
                IsEnabled="False"
                svc:Localized.HeaderKey="Taskbar.Addon.AllMonitors.Title"
                svc:Localized.DescriptionKey="Taskbar.Addon.AllMonitors.Description">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE7F4;" />
                </toolkit:SettingsCard.HeaderIcon>
                <ToggleSwitch svc:Localized.AutomationNameKey="Taskbar.Addon.AllMonitors.Title" x:Name="TaskbarAllMonitorsToggle" MinWidth="0" OnContent="" OffContent="" Toggled="TaskbarAllMonitorsToggle_Toggled" />
            </toolkit:SettingsCard>

            <InfoBar x:Name="ErrorInfoBar" IsOpen="False" Severity="Error" IsClosable="True" />
        </StackPanel>
    </StackPanel>
</UserControl>
