<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DeskBox.Controls.WidgetContents.AudioWidgetContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:svc="using:DeskBox.Services"
    Foreground="{ThemeResource TextFillColorPrimaryBrush}">

    <!-- OpenWinBox: like the Game Bar (Win+G) audio panel: output, input and per-app volume. -->
    <UserControl.Resources>
        <Style x:Key="AudioIconButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style x:Key="AudioDeviceButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
    </UserControl.Resources>

    <Grid Padding="10,6,10,10" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="6">
        <Grid ColumnDefinitions="Auto,*,36" ColumnSpacing="4" RowDefinitions="Auto,Auto">
            <Button x:Name="OutputDevice" Grid.ColumnSpan="3" Style="{StaticResource AudioDeviceButtonStyle}"
                    Click="Device_Click" Tag="Output"
                    svc:Localized.AutomationNameKey="Audio.ChangeOutput" svc:Localized.ToolTipKey="Audio.ChangeOutput">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                    <TextBlock svc:Localized.Key="Audio.Output" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="OutputName" Grid.Column="1" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <FontIcon Grid.Column="2" Glyph="&#xE70D;" FontSize="10" />
                </Grid>
            </Button>
            <Button x:Name="OutputMute" Grid.Row="1" Style="{StaticResource AudioIconButtonStyle}" Click="Mute_Click" Tag="Output"
                    svc:Localized.AutomationNameKey="Audio.MuteOutput" svc:Localized.ToolTipKey="Audio.Mute">
                <FontIcon x:Name="OutputMuteIcon" Glyph="&#xE767;" FontSize="14" />
            </Button>
            <Slider x:Name="OutputSlider" Grid.Row="1" Grid.Column="1" Maximum="100" VerticalAlignment="Center"
                    ValueChanged="DeviceSlider_ValueChanged" Tag="Output" svc:Localized.AutomationNameKey="Audio.OutputVolume" />
            <TextBlock x:Name="OutputValue" Grid.Row="1" Grid.Column="2" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right" />
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="Auto,*,36" ColumnSpacing="4" RowDefinitions="Auto,Auto">
            <Button x:Name="InputDevice" Grid.ColumnSpan="3" Style="{StaticResource AudioDeviceButtonStyle}"
                    Click="Device_Click" Tag="Input"
                    svc:Localized.AutomationNameKey="Audio.ChangeInput" svc:Localized.ToolTipKey="Audio.ChangeInput">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                    <TextBlock svc:Localized.Key="Audio.Input" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="InputName" Grid.Column="1" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <FontIcon Grid.Column="2" Glyph="&#xE70D;" FontSize="10" />
                </Grid>
            </Button>
            <Button x:Name="InputMute" Grid.Row="1" Style="{StaticResource AudioIconButtonStyle}" Click="Mute_Click" Tag="Input"
                    svc:Localized.AutomationNameKey="Audio.MuteInput" svc:Localized.ToolTipKey="Audio.Mute">
                <FontIcon x:Name="InputMuteIcon" Glyph="&#xE720;" FontSize="14" />
            </Button>
            <Slider x:Name="InputSlider" Grid.Row="1" Grid.Column="1" Maximum="100" VerticalAlignment="Center"
                    ValueChanged="DeviceSlider_ValueChanged" Tag="Input" svc:Localized.AutomationNameKey="Audio.InputVolume" />
            <TextBlock x:Name="InputValue" Grid.Row="1" Grid.Column="2" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right" />
        </Grid>

        <TextBlock Grid.Row="2" svc:Localized.Key="Audio.Apps" FontSize="12" Margin="8,4,0,0"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="AppList" Spacing="2" />
        </ScrollViewer>
        <TextBlock x:Name="NoApps" Grid.Row="3" svc:Localized.Key="Audio.NoApps" FontSize="12" Margin="8,4,0,0"
                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" Visibility="Collapsed" />
    </Grid>
</UserControl>
