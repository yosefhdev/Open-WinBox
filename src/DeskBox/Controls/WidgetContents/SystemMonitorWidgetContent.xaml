<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DeskBox.Controls.WidgetContents.SystemMonitorWidgetContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:svc="using:DeskBox.Services"
    Foreground="{ThemeResource TextFillColorPrimaryBrush}">

    <!-- OpenWinBox: live CPU, RAM, GPU, disk activity, network and drive usage. Each section can be hidden from the gear menu. -->
    <Grid Padding="12,4,12,12" RowDefinitions="Auto,Auto,*" RowSpacing="6">
        <Button x:Name="CustomizeButton" HorizontalAlignment="Right" Width="28" Height="28" Padding="0"
                Background="Transparent" BorderThickness="0" Click="Customize_Click"
                svc:Localized.AutomationNameKey="SystemMonitor.Customize" svc:Localized.ToolTipKey="SystemMonitor.Customize">
            <FontIcon Glyph="&#xE713;" FontSize="14" />
        </Button>

        <StackPanel Grid.Row="1" Spacing="10">
            <Grid x:Name="CpuSection" RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" RowSpacing="4">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE950;" FontSize="14" />
                    <TextBlock Text="CPU" FontSize="12" FontWeight="SemiBold" />
                </StackPanel>
                <TextBlock x:Name="CpuDetail" Grid.Column="1" FontSize="11" TextTrimming="CharacterEllipsis"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock x:Name="CpuValue" Grid.Column="2" FontSize="12" FontFamily="Consolas" />
                <ProgressBar x:Name="CpuBar" Grid.Row="1" Grid.ColumnSpan="3" Maximum="100" />
            </Grid>

            <Grid x:Name="MemorySection" RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" RowSpacing="4">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE964;" FontSize="14" />
                    <TextBlock Text="RAM" FontSize="12" FontWeight="SemiBold" />
                </StackPanel>
                <TextBlock x:Name="MemoryDetail" Grid.Column="1" FontSize="11" TextTrimming="CharacterEllipsis"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock x:Name="MemoryValue" Grid.Column="2" FontSize="12" FontFamily="Consolas" />
                <ProgressBar x:Name="MemoryBar" Grid.Row="1" Grid.ColumnSpan="3" Maximum="100" />
            </Grid>

            <Grid x:Name="GpuSection" RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" RowSpacing="4">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE7F4;" FontSize="14" />
                    <TextBlock Text="GPU" FontSize="12" FontWeight="SemiBold" />
                </StackPanel>
                <TextBlock x:Name="GpuDetail" Grid.Column="1" FontSize="11" TextTrimming="CharacterEllipsis"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock x:Name="GpuValue" Grid.Column="2" FontSize="12" FontFamily="Consolas" />
                <ProgressBar x:Name="GpuBar" Grid.Row="1" Grid.ColumnSpan="3" Maximum="100" />
            </Grid>

            <Grid x:Name="StorageSection" RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" RowSpacing="4">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE9D9;" FontSize="14" />
                    <TextBlock svc:Localized.Key="SystemMonitor.Storage" FontSize="12" FontWeight="SemiBold" />
                </StackPanel>
                <TextBlock x:Name="DiskDetail" Grid.Column="1" FontSize="11" TextTrimming="CharacterEllipsis"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock x:Name="DiskValue" Grid.Column="2" FontSize="12" FontFamily="Consolas" />
                <ProgressBar x:Name="DiskBar" Grid.Row="1" Grid.ColumnSpan="3" Maximum="100" />
            </Grid>

            <Grid x:Name="NetworkSection" ColumnDefinitions="Auto,*" ColumnSpacing="8">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE839;" FontSize="14" />
                    <TextBlock svc:Localized.Key="SystemMonitor.Network" FontSize="12" FontWeight="SemiBold" />
                </StackPanel>
                <TextBlock x:Name="NetworkValue" Grid.Column="1" FontSize="12" FontFamily="Consolas"
                           HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" />
            </Grid>
        </StackPanel>

        <ScrollViewer x:Name="DriveSection" Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="0,8,0,0"
                      BorderThickness="0,1,0,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
            <StackPanel x:Name="DriveList" Spacing="8" />
        </ScrollViewer>
    </Grid>
</UserControl>
